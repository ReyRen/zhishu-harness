# Single-user validation values. Production containers are managed by gcs-harness-worker.
ZHISHU_HARNESS_IMAGE=zhishu-harness:dev
DSH_CLIENT_COMMIT_HASH=
GCS_DSH_NETWORK=gcs-dsh-users
DSH_INTERNAL_PORT=3081
DSH_PUBLIC_AUTHORITY=dsh-web:3081
DSH_USER_ROOT_PATH=
DSH_RESOURCE_DOWNLOAD_TIMEOUT_MS=600000
TZ=Asia/Shanghai

# Built-in WeKnora tools. Configure the backend API, not the iframe page URL.
WEKNORA_BASE_URL=http://172.18.36.230:18090/api/v1
WEKNORA_API_KEY=
WEKNORA_TENANT_ID=
WEKNORA_KNOWLEDGE_BASE_IDS=
WEKNORA_AGENT_ID=
WEKNORA_RESOURCE_URLS=handle
