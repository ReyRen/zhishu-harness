{
  "name": "@zhishu/dsh-overlay-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "description": "Preinstalled knowledge-base workbench: iframe WeKnora UI with platform SSO and Ask-AI session dock.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-commands",
        "@zhishu/dsh-overlay-workbenches"
      ],
      "platform": "web"
    }
  }
}
