{
  "name": "dshmarket",
  "description": "Visual plugin market inside DeepSeek Harness — browse, search, and one-click install community plugins. · DSH 可视化插件市场：逛一逛，点一下，装好。",
  "version": "1.66.22",
  "private": true,
  "type": "module",
  "main": "host/index.js",
  "types": "host/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-market/dsh-market.git"
  },
  "homepage": "https://dshmarket.com",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "marketplace",
    "market",
    "plugin-manager"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "check": "npm run typecheck && npm run build && node scripts/restart-smoke.mjs",
    "test": "vitest run",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "validate:registry": "node scripts/validate-registry.mjs",
    "snapshot": "mkdir -p data && curl -sf https://awesome-dsh-plugin.com/plugins.json -o data/registry-snapshot.json && curl -sf https://awesome-dsh-plugin.com/readmes.json -o data/readmes-snapshot.json",
    "check:web-auth-capture": "node scripts/check-web-auth-capture.mjs",
    "test:web": "node scripts/check-web-auth-capture.mjs && vitest run --config vitest.web.config.ts",
    "build:site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "undici": "^7.29.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./host/types/index.d.ts",
      "default": "./host/index.js"
    },
    "./update-api-v1": {
      "types": "./host/types/update-api-v1.d.ts",
      "default": "./host/update-api-v1.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale",
    "host",
    "src",
    "client",
    "UPDATE-API-V1.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
